{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "Circle",
    "Audience": "Circle.Web",
    "SigningKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_IN_AZURE_APP_SETTINGS",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Otp": {
    "CodeLength": 6,
    "ExpiryMinutes": 10,
    "IncludeCodeInResponse": false
  },
  "FileStorage": {
    "RootPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "Circle.WebApi"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
