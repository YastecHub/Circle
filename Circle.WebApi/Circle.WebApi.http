@Circle.WebApi_HostAddress = http://localhost:5182
@AccessToken = paste-token-here

GET {{Circle.WebApi_HostAddress}}/api/health
Accept: application/json

###

POST {{Circle.WebApi_HostAddress}}/api/auth/bootstrap-admin
Content-Type: application/json

{
  "email": "admin@circle.local",
  "password": "Admin@12345",
  "fullName": "Circle Admin",
  "phone": "08000000000"
}

###

POST {{Circle.WebApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@circle.local",
  "password": "Admin@12345"
}

###

POST {{Circle.WebApi_HostAddress}}/api/auth/verify-otp
Content-Type: application/json

{
  "email": "admin@circle.local",
  "code": "123456"
}

###

GET {{Circle.WebApi_HostAddress}}/api/users
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{Circle.WebApi_HostAddress}}/api/users/credit-officers
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "email": "officer@circle.local",
  "fullName": "Circle Credit Officer",
  "phone": "08000000001",
  "branch": "Main"
}

###

GET {{Circle.WebApi_HostAddress}}/api/customers
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{Circle.WebApi_HostAddress}}/api/customers
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "customerCode": null,
  "passbookReference": null,
  "fullName": "Amina Bello",
  "phone": "08000000002",
  "alternatePhone": null,
  "address": "12 Market Road",
  "city": "Lagos",
  "state": "Lagos",
  "governmentIdType": "NIN",
  "governmentIdNumber": "12345678901",
  "dateOfBirth": "1992-04-18",
  "gender": "Female",
  "occupation": "Trader",
  "guarantorName": "Musa Bello",
  "guarantorPhone": "08000000003",
  "guarantorRelationship": "Brother",
  "guarantorIdNumber": "98765432109",
  "assignedCreditOfficerId": "paste-credit-officer-guid-here",
  "notes": "Initial customer record"
}

###

GET {{Circle.WebApi_HostAddress}}/api/loans
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{Circle.WebApi_HostAddress}}/api/loans
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "customerId": "paste-customer-guid-here",
  "principalAmount": 20000,
  "interestRatePercent": 10,
  "termCount": 10,
  "repaymentFrequency": "Daily",
  "firstRepaymentDate": "2026-05-25",
  "purpose": "Working capital"
}

###

POST {{Circle.WebApi_HostAddress}}/api/loans/paste-loan-guid-here/approve
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "note": "Approved by business owner"
}

###

POST {{Circle.WebApi_HostAddress}}/api/loans/paste-loan-guid-here/reject
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "reason": "Customer does not meet current approval rules"
}

###

GET {{Circle.WebApi_HostAddress}}/api/repayments
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{Circle.WebApi_HostAddress}}/api/repayments
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "loanId": "paste-loan-guid-here",
  "amount": 2200,
  "paymentDate": "2026-05-25",
  "method": "Cash",
  "reference": "CASH-001",
  "notes": "First repayment"
}
